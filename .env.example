# Database (MySQL) - add ?ssl={"rejectUnauthorized":false} for SSL
# IMPORTANT: Add connection_limit=3 for Vercel/serverless to avoid exhausting MySQL connections
# Example: mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME?connection_limit=3
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME?connection_limit=3

# Admin credentials (optional, defaults below)
# ADMIN_EMAIL=admin@sanaathrumylens.co.ke
# ADMIN_PASSWORD=sanaa2025

# CDN (image uploads)
NEXT_PUBLIC_CDN_URL=https://cdn.sanaathrumylens.co.ke
CDN_API_KEY=your-cdn-api-key-here
